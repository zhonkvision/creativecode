{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "system": "CreativeCode Visual DNA Token Architecture",
  "version": "4.0.0",
  "color": {
    "void_black": "#000000",
    "surface_slate": "#0a0a0a",
    "surface_elevated": "#121212",
    "border_wire": "#262626",
    "border_active": "#ff2424",
    "phosphor_green": "#ffffff",
    "phosphor_amber": "#ff2424",
    "phosphor_cyan": "#d4d4d4",
    "signal_red": "#ff2424",
    "mono_white": "#ffffff",
    "muted_telemetry": "#666666"
  },
  "typography": {
    "font_mono": "'JetBrains Mono', 'Courier New', monospace",
    "font_display": "'VT323', monospace",
    "font_code": "'JetBrains Mono', monospace",
    "tracking_tight": "-0.04em",
    "tracking_normal": "0.02em",
    "tracking_wide": "0.12em",
    "tracking_ultra": "0.22em"
  },
  "geometry": {
    "border_radius": "6px",
    "border_width": "1px",
    "corner_bracket_size": "4px",
    "grid_unit": "8px"
  },
  "texture": {
    "scanline_pitch": "3px",
    "scanline_opacity": 0.15,
    "chroma_offset": "1.5px",
    "crt_bloom": "6px",
    "dpr_clamp": 2.0
  }
}
