{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "system": "CreativeCode Visual DNA Token Architecture",
  "version": "3.1.0",
  "color": {
    "void_black": "#050709",
    "surface_slate": "#0a0e15",
    "surface_elevated": "#101520",
    "border_wire": "#222a3c",
    "border_active": "#ff4d6d",
    "phosphor_green": "#22e5a0",
    "phosphor_amber": "#ff9e64",
    "phosphor_cyan": "#5b93ff",
    "signal_red": "#ff4d6d",
    "mono_white": "#f0f3fa",
    "muted_telemetry": "#7d89a6"
  },
  "typography": {
    "font_mono": "'JetBrains Mono', 'Courier New', monospace",
    "font_display": "'VT323', monospace",
    "font_code": "'JetBrains Mono', monospace",
    "tracking_tight": "-0.04em",
    "tracking_normal": "0.02em",
    "tracking_wide": "0.12em",
