{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/projects",
      "destination": "/projects/projects.json"
    },
    {
      "source": "/experiment/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/specimen/:path*",
      "destination": "/index.html"
    }
  ]
}
